{
  "crons": [
    { "path": "/api/medical/reminders", "schedule": "0 23 * * *" },
    { "path": "/api/internal/lab/purge", "schedule": "10 6 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?apiPath=$1" },
    { "source": "/internal", "destination": "/internal.html" },
    { "source": "/estado", "destination": "/status.html" },
    { "source": "/cita-medica", "destination": "/medical.html" }
  ]
}
