# ── Variables PÚBLICAS (prefijo VITE_: viajan en el bundle del navegador) ──
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Solo para desarrollo local: si existe, submitBooking usa este webhook en vez de /api/booking
VITE_N8N_WEBHOOK_URL=https://your-tunnel.example/webhook/booking

# ── Variables PRIVADAS (solo servidor: configurarlas en Vercel → Environment Variables,
#    SIN el prefijo VITE_. Nunca commitear valores reales) ──
EVOLUTION_API_URL=https://your-evolution-host:port
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=your_whatsapp_instance_name
WHATSAPP_DESTINO=51900000000

# Modo prueba: imprime los mensajes en los logs del servidor sin enviar WhatsApp
# EVOLUTION_DRY_RUN=true
# Desactivar el comprobante que recibe el cliente en su WhatsApp
# CLIENT_COPY_ENABLED=false

# Opcional: webhook que guarda un respaldo de cada reserva (p.ej. n8n → Google Sheets)
BACKUP_WEBHOOK_URL=

# ── Supabase (sistema interno de grooming) ──
# URL y claves del proyecto (Supabase → Project Settings → API).
# La service_role va SOLO en el servidor (funciones de api/): jamás con prefijo VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# La anon key la usa el panel interno en el navegador (RLS deniega todo sin login)
SUPABASE_ANON_KEY=your_anon_key

# "short": WhatsApp corto a la veterinaria (con panel interno en producción). Default: full
# VET_MESSAGE_MODE=short
# "true": agrega el link de seguimiento /estado en el comprobante del cliente
# TRACKING_ENABLED=true
# Opcional: URL del panel interno si es distinta del dominio de la app
# INTERNAL_PANEL_URL=

# Solo local (NO subir a Vercel): token del CLI de Supabase
# SUPABASE_ACCESS_TOKEN=
